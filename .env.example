# Server-side admin credentials (never exposed to client).
ADMIN_EMAIL=admin@mediax.local
ADMIN_PASSWORD=change-me

# JWT signing secret — generate a strong random value for production.
JWT_SECRET=change-me-in-production

# Server port
SERVER_PORT=3001

# ---- LLM API（Agent 内容生成）----
# 以下环境变量作为 fallback 默认值。
# 用户在 Settings 页面（/settings）填写的配置优先级更高。
# 获取 API Key：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- Image Generation ----
# 以下环境变量作为 fallback 默认值。
# 用户在 Settings 页面（/settings）填写的配置优先级更高。
IMAGE_GEN_API_KEY=your-openai-api-key
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_MODEL=gpt-image-2

# ---- Proxy（访问外网 API）----
# 如本地有代理（Clash/V2Ray），设置后可让服务端 fetch 走代理访问被墙的 API
# HTTPS_PROXY=http://127.0.0.1:7890

# Optional: set to true to disable Vite HMR in constrained editing environments.
DISABLE_HMR=false
