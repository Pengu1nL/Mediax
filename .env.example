# Server-side admin credentials (never exposed to client).
ADMIN_EMAIL=admin@mediax.local
ADMIN_PASSWORD=change-me

# JWT signing secret — generate a strong random value for production.
JWT_SECRET=change-me-in-production

# Server port
SERVER_PORT=3001

# DeepSeek LLM API (for agent content generation)
# Get your key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Optional: set to true to disable Vite HMR in constrained editing environments.
DISABLE_HMR=false
